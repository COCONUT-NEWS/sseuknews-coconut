apiVersion: apps/v1
kind: Deployment
metadata:
  name: news-ai
spec:
  replicas: 1
  selector:
    matchLabels:
      app: news-ai
  template:
    metadata:
      labels:
        app: news-ai
    spec:
      containers:
      - name: news-ai-ctn
        image: ${HARBOR_URL}/sseuk/news-ai:latest
        imagePullPolicy: Always
        ports:
        - containerPort: 80
